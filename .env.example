SA_PASSWORD=YourStrong!Passw0rd
API_KEY=my-super-secret-key
JWT_SECRET=change-this-to-a-long-random-signing-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_Microsoft.AspNetCore.Identity.PasswordHasher

# Portfolio demo mode: adds a "Continue as Demo Admin" button to the admin
# login page. DEMO_ADMIN_PASSWORD must be the plaintext password that hashes
# to ADMIN_PASSWORD_HASH above. Set DEMO_MODE=false for a normal deployment.
DEMO_MODE=true
DEMO_ADMIN_PASSWORD=changeme123
